# Supabase Configuration
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here           # Safe for frontend
SUPABASE_SERVICE_KEY=your_service_role_key_here # NEVER commit or expose!
DATABASE_PASSWORD=your_database_password_here

# Rate Limiting
RATE_LIMIT_ANONYMOUS=10                # requests per minute
RATE_LIMIT_REGISTERED=60               # requests per minute

# Optional: For local development
DATABASE_URL=postgresql://postgres:your_password@db.xxxxx.supabase.co:5432/postgres

      "split": "none",
      "tags": ["fixture", "plain"],
      "difficulty": "beginner",
      "strip_header_until": "^Compiled:"
    },
    {
      "source": "split.md",
      "section": "mapping",
      "category": "fixtures",
      "slug": "split-guide",
      "title": "Split guide",
      "split": "h2",
      "tags": ["fixture", "split"],
      "skip_headings": ["table of contents", "Special Topic"],
      "parts": {
        "2. Second part": { "slug": "second", "title": "The second part" }
      }
    },
    {
      "source": "split.md",
      "section": "modding",
      "category": "fixture-extras",
      "slug": "special-topic",
      "title": "Special topic",
      "split": "none",
      "tags": ["fixture"],
      "only_headings": ["special topic"],
      "target": "drafts",
      "provenance": { "compiled": "2026-08-03" }
    },
    {
      "source": "links.md",
      "section": "mapping",
      "category": "fixtures",
      "slug": "links-article",

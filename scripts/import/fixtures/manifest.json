{
  "description": "Fixture manifest for scripts/import/fixtures/run.ts. Not in manifests/, so a default run never loads it.",
  "sources_root": "./sources",
  "defaults": {
    "game": "pz",
    "version": "build-42",
    "difficulty": "intermediate",
    "target": "articles",

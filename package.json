{
  "name": "dystopianwiki-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Dystopian Outcasts Wiki - Monorepo for Web & Mobile",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev --workspace=packages/web",
    "web:build": "npm run build --workspace=packages/web",
    "web:preview": "npm run preview --workspace=packages/web",
    "aurora": "npm run dev --workspace=packages/aurora",
    "aurora:build": "npm run build --workspace=packages/aurora",
    "aurora:test": "npm run test --workspace=packages/aurora",
    "mobile": "npm run start --workspace=packages/mobile",
    "shared:build": "npm run build --workspace=packages/shared",
    "sync": "tsx scripts/sync-articles.ts",
    "sync:dry-run": "tsx scripts/sync-articles.ts --dry-run",
    "nav": "tsx scripts/build-nav.ts",
    "nav:db": "tsx scripts/build-nav.ts --db",
    "nav:test": "tsx --test scripts/build-nav.test.ts",
    "sitemap": "tsx scripts/build-sitemap.ts",
    "our-mods": "tsx scripts/build-our-mods.ts",
    "import:b42": "tsx scripts/import/import-b42.ts",
    "import:check-links": "tsx scripts/import/check-links.ts",
    "kb:lint": "tsx scripts/kb/lint-articles.ts",
    "kb:gen-ref": "tsx scripts/kb/gen-lua-reference.ts",
    "kb:gen-ref:test": "tsx scripts/kb/fixtures/lua-reference/run.ts",
    "kb:gen-server": "tsx scripts/kb/gen-server-handbook.ts",
    "kb:gen-server:test": "tsx scripts/kb/fixtures/server-handbook/run.ts",
    "install:all": "npm install && npm install --workspaces",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@types/node": "^20.10.0",
    "dotenv": "^16.3.1",
    "glob": "^10.3.10",
    "gray-matter": "^4.0.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "react": "19.1.0",
    "sql.js": "^1.14.2"
  }
}
